APP_NAME="Kraken Simulator"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Deliberately NOT the Laravel default (database/database.sqlite) — that
# path sits OUTSIDE storage/, the only directory a persistent volume mount
# would cover in production. Everything this service holds (credentials,
# balances, orders, prices) would be silently wiped on every redeploy
# otherwise. See entrypoint.sh for where this path actually gets created.
DB_DATABASE=/var/www/html/storage/database.sqlite

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

# --- This simulator's own control surface (see app/Http/Controllers/
# InternalController.php) — price/balance/settings/webhook overrides. Never
# used by the real-protocol routes (/0/public, /0/private), which
# authenticate the Kraken way instead (see app/Kraken/RequestSigner.php).
# Empty = skip verification, same dev/sandbox convention used throughout
# this project. ---
KRAKEN_INTERNAL_TOKEN=

# A 'live' price pair (the default) tracks this URL — the real Kraken's own
# public Ticker. Point it elsewhere for an isolated test double, or set it
# empty to disable live tracking entirely (every pair just stays on its
# seeded/manual value, no outbound network call ever made).
KRAKEN_LIVE_UPSTREAM_URL=https://api.kraken.com/0/public/Ticker
KRAKEN_LIVE_REFRESH_SECONDS=30

# How long WebhookDispatcher waits for a subscriber to respond before giving
# up — this blocks the AddOrder/CancelOrder request that triggered the event.
KRAKEN_WEBHOOK_TIMEOUT_SECONDS=3
